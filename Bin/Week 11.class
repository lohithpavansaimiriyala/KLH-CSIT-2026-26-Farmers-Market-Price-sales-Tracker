private static void viewAllRecords() {
    if (crops.isEmpty()) {
        System.out.println("No crop records found.");
        return;
    }

    for (Crop crop : crops) {
        crop.displayDetails();
    }
}

private static void calculateTotalMarketRevenue() {
    double totalRevenue = 0;

    for (Crop crop : crops) {
        totalRevenue += crop.getTotalSaleAmount();
    }

    System.out.println(
        "Total Sales Revenue: ₹" + totalRevenue
    );
}